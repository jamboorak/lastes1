# Example environment variables for SMTP (do NOT commit your real .env)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=tls
SMTP_FROM_NAME="Resort Paradise"
# Environment Variables for Villa Soledad Resort System
# Copy this file to .env and fill in your actual values

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database Configuration (if different from config.php)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=resort_db

# Site Configuration (if different from config.php)
SITE_URL=http://localhost/restorts/
SITE_EMAIL=info@resortparadise.com
