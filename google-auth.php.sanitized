<?php
/**
 * Google OAuth Configuration
 * Values should be provided via environment variables.
 */

require_once 'config/config.php';

define('GOOGLE_CLIENT_ID', getenv('GOOGLE_CLIENT_ID') ?: '');
define('GOOGLE_CLIENT_SECRET', getenv('GOOGLE_CLIENT_SECRET') ?: '');
define('GOOGLE_REDIRECT_URI', SITE_URL . 'google-callback.php');

if (session_status() == PHP_SESSION_NONE) {
    session_start();
}

$_SESSION['oauth_state'] = bin2hex(random_bytes(16));

$google_oauth_url = 'https://accounts.google.com/o/oauth2/v2/auth?' . http_build_query([
    'client_id' => GOOGLE_CLIENT_ID,
    'redirect_uri' => GOOGLE_REDIRECT_URI,
    'response_type' => 'code',
    'scope' => 'openid email profile',
    'state' => $_SESSION['oauth_state'],
    'access_type' => 'offline',
    'prompt' => 'select_account consent'
]);

header('Location: ' . $google_oauth_url);
exit;
?>
